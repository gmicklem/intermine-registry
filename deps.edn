;; InterMine Registry 2.0 (Clojure re-implementation of the GSoC 2017 Node app).
;;
;;   clojure -M -m intermine-registry.core   ; run the server (PORT, default 3000)
;;   clojure -M:test                        ; unit and API compatibility tests
;;   clojure -M:fmt check | fix             ; formatting (configuration in .cljfmt.edn)
;;   clojure -T:build uber                  ; target/intermine-registry.jar
;;
;; Library versions follow the BlueGenes server (repos/bluegenes deps.edn) where
;; the two overlap.
{:paths ["src/clj" "resources"]

 :deps {org.clojure/clojure {:mvn/version "1.12.6"}

        ;; HTTP server, routing, pages
        ring/ring-core {:mvn/version "1.13.0"}
        ring/ring-jetty-adapter {:mvn/version "1.13.0"}
        compojure/compojure {:mvn/version "1.7.1"}
        metosin/ring-http-response {:mvn/version "0.9.5"}
        hiccup/hiccup {:mvn/version "1.0.5"}
        cheshire/cheshire {:mvn/version "5.13.0"}

        ;; Logging: tools.logging over SLF4J (Jetty 12 logs through SLF4J 2)
        org.clojure/tools.logging {:mvn/version "1.3.1"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.9"}}

 :aliases
 {;; clojure -M:test   (the namespaces are listed in intermine-registry.test-runner)
  :test {:extra-paths ["test/clj" "test/resources"]
         :main-opts ["-m" "intermine-registry.test-runner"]}

  ;; clojure -M:fmt check | fix
  :fmt {:deps {dev.weavejester/cljfmt {:mvn/version "0.12.0"}}
        :main-opts ["-m" "cljfmt.main"]}

  ;; clojure -T:build <task>   (tasks: see build.clj)
  :build {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
          :ns-default build}}}
